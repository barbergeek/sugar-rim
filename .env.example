# Bar Assistant API endpoint (no trailing slash)
BA_API_URL=http://localhost:8000/api

# Your Bar Assistant API token (from Profile > Personal Access Tokens)
BA_API_TOKEN=

# Bar ID to use (set via the Settings tab in the UI)
BA_BAR_ID=

# Optional: Flask secret key (auto-generated if blank)
SECRET_KEY=

# Optional: AI image generation (also set via Settings tab)
# Provider: openai | gemini | compatible
AI_IMAGE_PROVIDER=
AI_IMAGE_MODEL=
# Base URL for "compatible" providers, e.g. http://192.168.1.5:8080/v1
AI_IMAGE_BASE_URL=
AI_IMAGE_API_KEY=
